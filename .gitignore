.DS_Store
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.venv/
Benchmark/.venv
*.egg-info/
.cache/
# raw run outputs are regenerated (Benchmark/results/<exp>/<method>/<tier>/); keep the folder
Benchmark/results/*
!Benchmark/results/.keep-results
# generated by deploy scripts
Benchmark/deploy/aws/.instance
Benchmark/deploy/aws/.provers
Benchmark/deploy/aws/.prover_ids
Benchmark/deploy/besu/.network/
# Rust build output
Benchmark/native/pqzk_stark/target/
# LaTeX build files
Overleaf/revised/*.aux
Overleaf/revised/*.log
Overleaf/revised/*.fls
Overleaf/revised/*.fdb_latexmk
Overleaf/revised/*.out
Benchmark/deploy/aws/.workers
Benchmark/deploy/aws/.image
Benchmark/deploy/aws/.image_builder
